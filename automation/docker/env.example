# automation/docker/env.example
#
# Copy to automation/docker/.env (gitignored) and fill in real values:
#   cp automation/docker/env.example automation/docker/.env
# Docker Compose loads .env from this directory automatically, for both
# docker-compose.dev.yml and docker-compose.yml.
#
# Placeholders only. Never commit a filled-in copy.
# See docs/local-setup.md for which services need which keys.

# -----------------------------------------------------------------------------
# Deployment selection
# -----------------------------------------------------------------------------
DOMAIN=kkb                          # dev-kit/configs/<DOMAIN>/ supplies the domain YAML
DPG_IMAGE_TAG=sha-646216d           # GHCR tag for docker-compose.dev.yml
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# REQUIRED to boot the core stack
# -----------------------------------------------------------------------------
# LLM key for the domain's provider (agent.provider in agent_core.yaml).
# kkb uses openai. A dummy value lets the stack boot; chat turns then fail
# at the LLM call with error_type=api_error.
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OLLAMA_ENDPOINT=
OLLAMA_API_KEY=

# Connector secrets (auth.secret_env in action_gateway.yaml, e.g. kkb's
# ONEST_API_KEY) are per domain and do NOT go here. Put them in
# dev-kit/configs/<DOMAIN>/secrets.env (see secrets.env.example there).

# -----------------------------------------------------------------------------
# REQUIRED only if reach_layer_voice is started (Vobiz telephony)
# reach_layer_voice exits at startup if VOBIZ_AUTH_ID is empty.
# -----------------------------------------------------------------------------
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
RAYA_API_KEY=
PUBLIC_URL=                         # public https URL that reaches :8006

# ngrok tunnel for the voice channel (ngrok service only)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------
# Web channel auth; required only when reach_layer auth.enabled: true
GOOGLE_CLIENT_ID=
REACH_SESSION_SECRET=

# Document upload chain (dev-kit -> reach-layer -> knowledge-engine -> dev-kit)
DEVKIT_TO_REACH_API_KEY=
REACH_TO_KE_API_KEY=
KE_TO_DEVKIT_API_KEY=

# Azure Blob Storage; only when the domain ingests KB documents from Azure
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=

# Memgraph auth (empty = no auth, fine locally)
MEMGRAPH_PASSWORD=

# Grafana admin password (defaults to "admin" when unset)
GF_SECURITY_ADMIN_PASSWORD=

DEVKIT_LOG_LEVEL=INFO
