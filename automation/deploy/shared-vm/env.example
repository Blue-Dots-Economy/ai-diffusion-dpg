# ai-diffusion-dpg — shared VM.  Copy to .env and chmod 600.
#
# No secrets live here. OPENAI_API_KEY and BLUE_DOTS_API_KEY are fetched at
# startup by the init_secrets container from AWS SSM Parameter Store.

# ---- images --------------------------------------------------------------
# GHCR tags are MUTABLE. Pin the digest for anything that must be
# reproducible: see README, "Pinning by digest".
# The tag must be built from the same commit as the config in this checkout:
# the Action Gateway config uses ${SIGNALS_*:-...} URLs, which older images
# do not expand. Rebuild and bump this tag before moving the checkout forward.
DPG_IMAGE_TAG=sha-646216d

# ---- AWS -----------------------------------------------------------------
AWS_REGION=
# Parameter path prefix; init_secrets reads <prefix>/openai_api_key and
# <prefix>/blue_dots_api_key. Supplied by the team that owns the VM.
# Optional, for Discord alerts: <prefix>/discord_webhook_critical,
# <prefix>/discord_webhook_warning and <prefix>/discord_webhook_info.
SSM_PREFIX=

# ---- alerting ------------------------------------------------------------
# Discord webhooks, one per severity. Secrets: on the VM keep them in SSM
# (above) and leave these blank; set them here only on a host without SSM.
# Unset ones fall back to a placeholder, so those alerts show in Grafana but
# do not reach Discord (init_secrets logs which).
DISCORD_WEBHOOK_CRITICAL=
DISCORD_WEBHOOK_WARNING=
DISCORD_WEBHOOK_INFO=
# Base URL for links in alert messages. Default suits the SSH tunnel.
# GRAFANA_ROOT_URL=http://localhost:3001

# ---- non-secret config ---------------------------------------------------
# Organisation UUID sent as the x-acting-org-id header. Not a credential.
BLUE_DOTS_ORG_ID=

# Signals cluster that action_gateway talks to. Defaults are the UAT cluster;
# change all three to point at another one. Not credentials.
SIGNALS_BASE_URL=https://signals.bluedotseconomy.org
SIGNALS_SEARCH_URL=https://signals.bluedotseconomy.org/signals-search
SIGNALS_INSTANCE_URL=https://signals.bluedotseconomy.org

# Domain config mounted from dev-kit/configs/<DOMAIN>/ in the clone.
DOMAIN=blue-dots

LOG_LEVEL=INFO

# ---- tool-result persistence ---------------------------------------------
# REQUIRED for the Blue Dots voice flow. Generate one per deployment:
#
#     openssl rand -hex 32
#
# Leaving this empty does NOT merely "disable a cache". Tool results stop
# surviving between turns, so the job list offered on one turn is gone by the
# next. The caller's "पहला वाला" then resolves against nothing, the turn
# degrades, and NO profile and NO application are ever created — while the bot
# still speaks as though both happened. Measured: applications went 0 -> 3 on an
# identical build by setting this alone.
#
# No default is shipped on purpose: a shared HMAC key across deployments is
# worse than none. Passed to memory_layer from this file, like
# MEMGRAPH_PASSWORD. Never commit a value.
TOOL_RESULT_KEY_SECRET=

# ---- human handoff (trust_layer, queue_backend: webhook) -------------------
# Used only when the domain's trust.hitl.queue_backend is webhook. Unset URL or
# secret means handoffs are not delivered (reason "misconfigured"). URL must be
# HTTPS unless HITL_WEBHOOK_ALLOW_HTTP=1 (local testing only). The secret signs
# each request (X-Handoff-Signature). Passed to trust_layer from this file.
# Never commit a value.
HITL_WEBHOOK_URL=
HITL_WEBHOOK_SECRET=
HITL_WEBHOOK_ALLOW_HTTP=

# Optional overrides; defaults are correct for this compose file.
# REDIS_URL=redis://redis:6379/0
# MEMGRAPH_PASSWORD=
