# dev-kit/configs/blue-dots/secrets.env.example
#
# Connector secrets for the blue-dots domain: one line per secret_env in
# action_gateway.yaml (auth.secret_env and extra_headers[].secret_env).
# Copy to secrets.env in this directory (gitignored); automation/docker
# compose loads it into action_gateway when DOMAIN=blue-dots.
#   cp dev-kit/configs/blue-dots/secrets.env.example dev-kit/configs/blue-dots/secrets.env
#
# Action Gateway will not start while a declared secret_env is unset. Dummy
# values are enough to boot locally; real calls to Signals then fail auth.

# Signals API key (x-api-key) for fetch_profile, save_profile, apply_job
# -> https://dev-signals.serveirc.com
BLUE_DOTS_API_KEY=replace-me

# Acting org / tenant id (x-acting-org-id header) sent with BLUE_DOTS_API_KEY
BLUE_DOTS_ORG_ID=replace-me

# Signals search API key (x-api-key) for fetch_jobs
# -> https://dev-signals.serveirc.com/signals-search
BLUE_DOTS_SEARCH_API_KEY=replace-me
