# Connector API keys for Action Gateway tools.
#
# This file mirrors the Helm `extraSecrets` pattern: no key names are baked
# into docker-compose — only the keys your domain actually uses live here.
#
# Setup:
#   cp connector_secrets.env.example connector_secrets.env
#   # fill in real values in connector_secrets.env
#
# connector_secrets.env is gitignored (*.env rule) — never commit real secrets.
# This .example file is safe to commit; keep values blank.

ONEST_API_KEY=
