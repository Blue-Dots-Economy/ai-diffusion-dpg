# dev-kit/configs/kkb/secrets.env.example
#
# Connector secrets for the kkb domain: one line per auth.secret_env in
# action_gateway.yaml. Copy to secrets.env in this directory (gitignored);
# automation/docker compose loads it into action_gateway when DOMAIN=kkb.
#   cp dev-kit/configs/kkb/secrets.env.example dev-kit/configs/kkb/secrets.env
#
# Action Gateway will not start while a declared secret_env is unset. A dummy
# value is enough to boot locally; real calls to the connector then fail auth.

# onest_market_lookup -> https://up-onest-lite-bap.dhiway.net (X-API-KEY header)
ONEST_API_KEY=replace-me
